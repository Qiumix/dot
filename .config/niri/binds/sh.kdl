binds {
    Ctrl+Alt+P {
        spawn-sh "playerctl play-pause --player=splayer_next"
    }
    Ctrl+Alt+0 {
        spawn-sh "playerctl next --player=splayer_next"
    }
    Ctrl+Alt+9 {
        spawn-sh "playerctl previous --player=splayer_next"
    }
    Mod+F12 {
        spawn-sh "~/.config/niri/03_scripts/toggle.fish ironbar ironbar"
    }
    Mod+F11 {
        spawn-sh "~/.config/niri/03_scripts/toggle.fish bar-rs bar-rs open"
    }
    Mod+F10 {
        spawn-sh "~/.config/niri/03_scripts/toggle.fish kanata kanata"
    }
    Mod+F9 {
        spawn-sh "~/.config/niri/03_scripts/toggle.fish dms dms run"
    }
    Mod+F8 {
        spawn-sh "~/.config/niri/03_scripts/toggle.fish showmethekey-gtk showmethekey-gtk -A -k"
    }
    Mod+Alt+L {
        spawn-sh "hyprlock --config ~/.config/niri/02_misc/hyprlock.conf"
    }
    Mod+X hotkey-overlay-title=null {
        spawn "wlogout"
    }
}
