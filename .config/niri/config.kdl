include "./animation.kdl"
include "./binds/init.kdl"
include "./env.kdl"
include "./layers/init.kdl"
include "./layout.kdl"
include "./output.kdl"
include "./spawn.kdl"
include "./touch_pad.kdl"
include "./windows/init.kdl"
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
cursor {
  xcursor-theme "Elaina"
  xcursor-size 24
  hide-after-inactive-ms 15000
}
input {
  keyboard {
    repeat-rate 80
    repeat-delay 170
    numlock
  }
  mouse {
    accel-profile "adaptive"
    accel-speed 0.5
  }
}
hotkey-overlay {
  skip-at-startup
}
clipboard {
  disable-primary
}
