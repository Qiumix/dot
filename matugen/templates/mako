# vim:se ft=ini:
# mako colors — generated by matugen

# ---------- Font ----------
font=Maple Mono NF CN 11

# ---------- Geometry ----------
width=340
height=150
padding=12,16
margin=8,12
outer-margin=0
border-size=1
border-radius=14
max-icon-size=52
icon-border-radius=10
text-alignment=left
icons=1

# ---------- Base colors ----------
background-color={{colors.surface_container.default.hex}}
text-color={{colors.on_surface.default.hex}}
border-color={{colors.outline_variant.default.hex}}
progress-color=over {{colors.primary.default.hex}}

# ---------- Actionable: primary border hint ----------
[actionable]
border-color={{colors.primary.default.hex}}
border-size=2

# ---------- Critical: error container ----------
[urgency=critical]
background-color={{colors.error_container.default.hex}}
text-color={{colors.on_error_container.default.hex}}
border-color={{colors.error.default.hex}}
border-size=2

# ---------- Low priority: lower contrast ----------
[urgency=low]
background-color={{colors.surface_container_low.default.hex}}
text-color={{colors.on_surface_variant.default.hex}}
border-color={{colors.outline_variant.default.hex}}

# ---------- Grouped: raised surface + primary border ----------
[grouped]
background-color={{colors.surface_container_high.default.hex}}
border-color={{colors.primary.default.hex}}
border-size=2

# ---------- Hidden placeholder ----------
[hidden]
background-color={{colors.surface_variant.default.hex}}
text-color={{colors.on_surface_variant.default.hex}}
border-color={{colors.outline_variant.default.hex}}
