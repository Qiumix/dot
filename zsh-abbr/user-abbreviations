abbr gl=tig
abbr gcl='git clone'
abbr gcls='git clone --single-branch --depth 1'
abbr gac='git add . and git commit -m'
abbr ga='git add'
abbr ga. 'git add .'
abbr gb='git branch'
abbr gr='git remote'
abbr gre='git reset'
abbr grh='git reset --hard'
abbr gbr='git branch -r'
